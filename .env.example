# Copy to .env and fill in. .env is never committed or copied by deploy/push.sh.

# --- Web UI ---
# The one password for the UI.
APP_PASSWORD=change-me
# Signs the login cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me
# true on the VPS behind HTTPS, false for local http://127.0.0.1
COOKIE_SECURE=false
# SQLite file; relative paths are from the project root.
DATABASE_PATH=data/concerts.db
# Public address of the UI, used for the "All shows" link in alerts (e.g. https://concerts.example.com)
APP_URL=http://localhost:8000

# --- Scanning ---
# https://console.apify.com/settings/integrations  (X + Instagram)
APIFY_API_TOKEN=
# https://platform.claude.com/settings/keys  (reads posts, pages and flyer images)
ANTHROPIC_API_KEY=
# Optional overrides
# CLAUDE_MODEL=claude-haiku-5-5
# CLAUDE_CONCURRENCY=15          # most Claude calls at once; kept under the account's rate limits as it runs
# APIFY_MAX_USD_PER_RUN=1.0      # hard cap Apify enforces on each actor run
# Defaults only: both are changed on the Scans page (Schedule), which wins once saved.
# SCAN_EVERY_HOURS=12            # scheduled scans (cron starts the watcher hourly; it scans when one is due)
# INSTAGRAM_COOLDOWN_HOURS=0     # 0 = read Instagram on every scan, like X; N = skip it if read less than N hours
#                                # ago. Each read costs ~$0.06 even when nothing is new (~$3.60/month at 2 scans a day)
# APIFY_CONCURRENCY=5            # most Apify runs at once; never more than the account allows (free plan: 5)
# RETRIES=2                      # tries again after a timeout / 5xx / 429 / DNS error (3 s, then 9 s)
# FIRST_SCAN_DAYS=120            # how far back the first scan of an account reads
# BROWSER_FALLBACK=true          # headless Chromium for pages built by JavaScript

# --- Alerts (Discord) ---
# A webhook for a channel on your own private server: Edit Channel -> Integrations -> Webhooks ->
# New Webhook -> Copy Webhook URL. Free. Anyone with this URL can post to the channel: keep it secret.
DISCORD_WEBHOOK_URL=
# Your Discord user ID (Developer Mode -> right-click your name -> Copy User ID): every show alert pings you.
# Empty: alerts are sent without a ping.
DISCORD_USER_ID=
# Silent "scan started" / "scan finished" messages (no ping, no phone notification). 0 turns them off.
# DISCORD_SCAN_NOTICES=1
